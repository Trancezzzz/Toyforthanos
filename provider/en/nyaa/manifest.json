{
  "id": "nyaa-plus",
  "name": "Nyaa+",
  "description": "Improved Nyaa provider — multi-language smart search (English, Romaji, Japanese), accurate season/episode handling, all smart-search options (batch, episode, resolution, query, best releases), instant magnets from RSS info hashes. Drop-in upgrade for the built-in Nyaa provider.",
  "manifestURI": "https://raw.githubusercontent.com/Trancezzzz/Toyforthanos/master/provider/en/nyaa/manifest.json",
  "version": "2.0.0",
  "semverConstraint": ">= 3.5.1",
  "author": "Trancezzz",
  "type": "anime-torrent-provider",
  "language": "typescript",
  "lang": "multi",
  "icon": "https://nyaa.si/static/favicon.png",
  "userConfig": {
    "requiresConfig": false,
    "version": 1,
    "fields": [
      {
        "name": "apiUrl",
        "label": "API URL",
        "type": "text",
        "default": "https://nyaa.si"
      },
      {
        "name": "category",
        "label": "Category",
        "type": "text",
        "default": "1_2"
      },
      {
        "name": "filter",
        "label": "Filter (0 = none, 1 = no remakes, 2 = trusted only)",
        "type": "text",
        "default": "0"
      },
      {
        "name": "maxResults",
        "label": "Max results per query",
        "type": "text",
        "default": "60"
      }
    ]
  },
  "payloadURI": "https://raw.githubusercontent.com/Trancezzzz/Toyforthanos/master/provider/en/nyaa/provider.ts",
  "payload": "",
  "isDevelopment": false
}
